<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NeuroFlow" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Transparent launcher theme that shows system wallpaper -->
    <style name="Theme.Launcher.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <!-- windowIsTranslucent removed: causes BadTokenException on MIUI/HyperOS when
             set as default launcher. Wallpaper is shown via windowShowWallpaper instead. -->
        <!-- Transparent nav bar so wallpaper shows through -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Light nav bar = dark (visible) buttons on light wallpapers -->
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- HyperFocus black home: opaque black, no wallpaper, edge-to-edge.
         Parent is the dark Material theme so windowLight* stays false and the system-bar
         buttons remain visible; Theme.Launcher.Transparent sets both light flags true for
         wallpapers, and copying that here would make the navigation buttons invisible. -->
    <style name="Theme.HyperFocusHome" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
